# ============================================================
# AayuVault — OpenAI API Configuration
# ============================================================

# Paste your OpenAI API Key below:
OPENAI_API_KEY=

# Preferred OpenAI Model (gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# OpenAI API Organization ID (optional)
OPENAI_ORG_ID=

# Temperature for clinical analysis (0.0 to 1.0; 0.2 recommended for deterministic medical extraction)
OPENAI_TEMPERATURE=0.2

# Database Settings
DB_HOST=localhost
DB_NAME=clinic_db
DB_USER=root
DB_PASS=
